# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# launch-week secrets gathering file (tokens, deploy hook URL, contact numbers)
/docs/launch-values.md

# LaTeX build artefacts (keep .tex and .pdf, drop the rest)
/docs/*.aux
/docs/*.log
/docs/*.out
/docs/*.toc
/docs/*.synctex.gz

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
qa-shots/
!.env.example
