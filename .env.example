# Copy to .env.local for local work. Never commit real values.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# demo: noindex + placeholder markers. production: indexable, photo gate enforced.
SITE_MODE=demo
NEXT_PUBLIC_SHOW_PLACEHOLDERS=true
# Enquiry email (Resend). Without a key the form runs in demo mode and only logs.
RESEND_API_KEY=
ENQUIRY_TO=arboretumgreenhotel@gmail.com
ENQUIRY_FROM=
# Sanity CMS. Without a project id the build uses content/*.json.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_WRITE_TOKEN=
